# Copy to .env and fill in. NEVER commit .env
# Used when running the API outside Docker. Compose ignores this line: its
# backend always uses the local db unless the staging overlay is passed.
DATABASE_URL=postgresql://museum:museum@db:5432/museum
# Staging database (hosted Supabase Postgres): session-mode pooler URL +
# ?sslmode=require. Storing it here does NOT select staging; everything stays
# local by default. Opt in per command, from the shell (never put DB_TARGET
# in this file):
#   DB_TARGET=staging ./scripts/apply_migrations.sh   # also backup/restore/import/repoint
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d --force-recreate backend
#DATABASE_URL_STAGING=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SECRET_KEY=change-me-in-local-development
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api
# Media backend switch: supabase | r2 | local (default local = zero-config
# uploads on a docker volume; see docs/design/media-storage.md).
MEDIA_BACKEND=local
# Supabase Storage for staff media uploads. Leave blank for local-only dev
# (reads still work from seed URLs). NEVER commit real keys.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=museum-media
# Cloudflare R2 warm standby (S3 API). Token scoped to one bucket.
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=museum-media
R2_PUBLIC_BASE=
# Local fallback directory (docker volume uploads-data in compose).
LOCAL_UPLOAD_DIR=/app/uploads
MAX_IMAGE_MB=5
MAX_VIDEO_MB=40
