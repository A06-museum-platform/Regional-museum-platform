# Copy to .env and fill in. NEVER commit .env
DATABASE_URL=postgresql://museum:museum@db:5432/museum
# Staging database (hosted Supabase Postgres): session-mode pooler URL +
# ?sslmode=require. When set, the DB scripts (migrations/backup/restore)
# target staging instead of the local compose db. Leave blank for local-only.
# Compose also passes this URL to the backend as DATABASE_URL. Recreate the
# backend after changing it. Shell scripts read this setting from .env;
# export DATABASE_URL_STAGING='' to explicitly force offline/local scripts.
#DATABASE_URL_STAGING=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SECRET_KEY=change-me-in-local-development
ACCESS_TOKEN_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000/api
# Media backend switch: supabase | r2 | local (default local = zero-config
# uploads on a docker volume; see docs/design/media-storage.md).
MEDIA_BACKEND=local
# Supabase Storage for staff media uploads. Leave blank for local-only dev
# (reads still work from seed URLs). NEVER commit real keys.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=museum-media
# Cloudflare R2 warm standby (S3 API). Token scoped to one bucket.
R2_ENDPOINT=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=museum-media
R2_PUBLIC_BASE=
# Local fallback directory (docker volume uploads-data in compose).
LOCAL_UPLOAD_DIR=/app/uploads
MAX_IMAGE_MB=5
MAX_VIDEO_MB=40
