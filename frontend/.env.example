# Copy this file to .env.local and adjust. .env.local is gitignored.

# Base path for the API. Leave as /api — Vite proxies it to the backend
# container in development.
VITE_API_BASE_URL=/api

# true  = every api/ function returns local mock data (no backend needed)
# false = real HTTP requests go to VITE_API_BASE_URL
#
# Keep this true until Ray's endpoints land in Week 7. Flipping it to false is
# the ONLY change needed on the front end — if a page breaks when you flip it,
# the mock and the contract had drifted apart.
VITE_USE_MOCKS=true

# Artificial delay (ms) on mock responses so loading states are actually
# visible while developing. Set to 0 to make the app feel instant.
VITE_MOCK_DELAY=400
